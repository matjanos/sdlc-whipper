# --- Conductor (this repo) ---
# Linear tracker adapter (GraphQL). Settings → Security & access → Personal API keys.
LINEAR_API_KEY=
# OR the linear-mcp adapter (Linear remote MCP; API keys work as bearer):
# LINEAR_MCP_URL=https://mcp.linear.app/mcp
# LINEAR_MCP_TOKEN=

# --- Code host ---
# GitHub adapter uses the `gh` CLI: run `gh auth login`.
# If the conductor pushes branches itself, use a PAT or GitHub App token —
# GITHUB_TOKEN-created PRs do not trigger other workflows (e.g. preview.yml).
# GITHUB_TOKEN=

# --- Vercel preview adapters ---
# vercel-mcp needs the deployments tool + a token; falls back to URL probing.
# VERCEL_MCP_URL=https://mcp.vercel.com/mcp
# VERCEL_MCP_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# --- OpenCode runtime ---
# Model provider keys live in your opencode user config (~/.config/opencode);
# the embedded SDK host reuses them. No keys needed here.

# --- Offline demo mode ---
# SDL_FAKE_TICKETS=/absolute/path/to/tickets.json

# --- Env-gated adapter contract tests (optional) ---
# LINEAR_TEST_TEAM=
